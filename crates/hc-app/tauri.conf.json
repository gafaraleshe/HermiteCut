{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HermiteCut Preview",
  "identifier": "com.hermitelabs.cut.preview",
  "build": {
    "frontendDist": "../../core/ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Video",
    "shortDescription": "The editing toolkit for DaVinci Resolve.",
    "copyright": "Copyright © 2026 Gafar / Hermite Labs",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../build/resources/": "data/",
      "../../hosts/resolve/bridge.lua": "bridge.lua"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
